# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Your own Discord user ID (enable Developer Mode, right-click yourself -> Copy User ID)
OWNER_ID=0

# Optional: your test server's ID for INSTANT slash-command updates while developing.
# Leave 0 for production (global commands can take up to an hour to appear).
DEV_GUILD_ID=0

# Clash of Clans developer-portal login (used by coc.py: tracking, /cwl, max-level lookups)
COC_EMAIL=
COC_PASSWORD=

# Optional: text shown at the bottom of /help (e.g. a server invite or your tag)
OWNER_CONTACT=

# Optional: custom database location (default: ./otto.db)
# DB_PATH=
